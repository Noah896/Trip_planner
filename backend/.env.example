# ===== 复制为 .env 后填入真实值 =====
# .env 已被 .gitignore 忽略,请勿把真实密钥提交到仓库

# ---- LLM 配置(OpenAI 兼容协议)----
# 模型名称
LLM_MODEL_ID=Qwen/Qwen3.5-27B
# 服务地址
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# API 密钥(二选一,LLM_API_KEY 优先,缺省回退 MODELSCOPE_API_KEY)
LLM_API_KEY=
MODELSCOPE_API_KEY=
# 请求超时(秒)
LLM_TIMEOUT=60

# ---- 服务器配置 ----
# 运行环境:development(默认,开启热重载)/ production(关闭热重载)
APP_ENV=development
HOST=0.0.0.0
PORT=8000
# 允许跨域的前端地址,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ---- 高德地图(必填,缺失会导致启动时配置校验失败)----
AMAP_API_KEY=

# ---- Unsplash 图片服务(可选,未配置时景点配图接口返回空)----
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
