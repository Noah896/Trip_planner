# ===== 复制为 .env 后填入真实值 =====
# .env 已被 .gitignore 忽略,请勿把真实密钥提交到仓库

# ---- LLM 配置(OpenAI 兼容协议)----
# 模型名称
LLM_MODEL_ID=Qwen/Qwen3.5-27B
# 服务地址
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# API 密钥(二选一,LLM_API_KEY 优先,缺省回退 MODELSCOPE_API_KEY)
LLM_API_KEY=
MODELSCOPE_API_KEY=
# 请求超时(秒)
LLM_TIMEOUT=60

# 是否开启模型 thinking(思考)模式,默认 false。
# Qwen3.5 默认开启 thinking,而该模式下服务端拒绝 tool_choice=required,
# 会让 response_format 结构化输出直接返回 400(只能走 JSON 文本兜底),
# 同时明显拖慢 4 次模型调用。因此这里默认关闭。
# 注意:enable_thinking 是 Qwen(ModelScope/DashScope)专用参数,
# 换成其它 OpenAI 兼容服务商若报 400,需要调整 app/services/llm_service.py。
LLM_ENABLE_THINKING=false

# 单次模型输出上限(token)。0 = 不限制(默认)。
# 默认关着:实测的失败原因是 schema 不匹配而不是输出过长,而截断反而会让
# 结构化输出直接判失败,所以"能用就不加约束"。
LLM_MAX_TOKENS=0

# ---- 单次 /plan 的收敛约束(2026-10-16 新增)----
# 单个检索/规划 Agent 的 LangGraph 循环上限。
# 结构化输出一旦校验失败,模型会把同一份参数原样重发,不加约束就会一直重试
# (实测 6 次重试 = 100 秒,端到端表现为 11 分钟不返回)。
AGENT_RECURSION_LIMIT=12
# 整条 /api/trip/plan 的墙钟上限(秒)。超时直接走降级,而不是把客户端超时打满。
# 注意 LLM_TIMEOUT 只约束"两次读取之间的间隔",对流式响应不构成总时长约束。
PLAN_TOTAL_TIMEOUT=240

# ---- 服务端会话记忆(SQLite)----
# 会话内可以继续修改上一版行程;长期偏好/历史行程后续也复用这个数据库。
MEMORY_DB_PATH=data/trip_memory.sqlite3
# 会话状态保留天数(过期记录会在读写时顺带清理)。
MEMORY_SESSION_TTL_DAYS=30

# ---- 账号鉴权(默认开启)----
# 开启后,行程、聊天和记忆接口必须携带 `Authorization: Bearer <token>`。
AUTH_ENABLED=true
AUTH_DB_PATH=data/trip_auth.sqlite3
AUTH_SESSION_TTL_DAYS=30
# 是否开放注册。生产环境建议关闭注册,或设置高熵邀请码。
AUTH_ALLOW_REGISTRATION=true
AUTH_REGISTRATION_KEY=

# ---- 服务器配置 ----
# 运行环境:development(默认,开启热重载)/ production(关闭热重载)
APP_ENV=development
HOST=0.0.0.0
PORT=8000
# 允许跨域的前端地址,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ---- 高德地图(必填,缺失会导致启动时配置校验失败)----
AMAP_API_KEY=

# ---- 高德 MCP Server(可选,一般不用改)----
# 后端会用 uvx 拉起一个**常驻**的 amap-mcp-server,并通过 streamable-http 调用。
# 默认等价于:
#   uvx --with "pydantic<2.14" amap-mcp-server streamable-http  (监听 127.0.0.1:8001)
#
# 这两段参数都是必需的,各有原因:
# 1) pydantic<2.14 —— amap-mcp-server 硬锁 mcp==1.8.1,而 mcp 1.8.1 会导入
#    eval_type_backport,该符号在 pydantic 2.14 中被删除。uvx 每次都现场解析
#    依赖,不约束的话 MCP 子进程会在启动时崩溃,规划请求全部降级为占位行程。
# 2) streamable-http —— stdio 模式下**每次工具调用都会新起一个 uvx 进程**
#    (单次数秒),一次 /plan 有 20+ 次工具调用,会把请求从秒级拖到分钟级。
#
# 若 uvx 不在 PATH,可把 AMAP_MCP_COMMAND 指向 <venv>\Scripts\uvx.exe
# AMAP_MCP_COMMAND=uvx
# AMAP_MCP_ARGS=--with pydantic<2.14 amap-mcp-server streamable-http
# AMAP_MCP_HOST=127.0.0.1
# AMAP_MCP_PORT=8001
#
# 若 MCP Server 由外部托管(docker compose / 独立进程),设置下面这项后由你负责启停:
# AMAP_MCP_URL=http://127.0.0.1:8001/mcp

# ---- Unsplash 图片服务(可选,未配置时景点配图接口返回空)----
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
